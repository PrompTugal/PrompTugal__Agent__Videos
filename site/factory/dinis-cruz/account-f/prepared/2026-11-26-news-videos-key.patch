+          # deleted after the next green push run on dev or after 24 hours: empty means the normal lookup of the anchor.
+          SIG_BOOTSTRAP_ANCHOR: ${{ vars.SIG_BOOTSTRAP_ANCHOR }}
           GIT_NO_REPLACE_OBJECTS: '1'
           NODE_OPTIONS: ''
           # pushed .gitattributes are switched off, the index copy too (events.b@'s e774ff9): attributes from the empty tree
@@ -120,6 +123,18 @@ jobs:
           # with write access can make one). A pushed rewrite of this workflow is still the known gap: only branch protection
           # closes it (Dinis's to set). Tags and BEFORE are not used; a manual run checks A..HEAD the same way.
           base_of() {
+            # The anchor override (cl-6.security's key bootstrap, 26 Nov 2026): while IaC's variable is set, the anchor is that
+            # commit; the checks on A stay as for a looked-up anchor (40 hex, in this clone, an ancestor of AFTER), and every
+            # checker is still copied from A.
+            if [ -n "${SIG_BOOTSTRAP_ANCHOR:-}" ]; then
+              local o="$SIG_BOOTSTRAP_ANCHOR"
+              [[ "$o" =~ ^[0-9a-f]{40}$ ]] || { echo "SIG_BOOTSTRAP_ANCHOR is not a full commit id: refusing" >&2; return 1; }
+              GIT_NO_REPLACE_OBJECTS=1 git cat-file -e "$o^{commit}" 2>/dev/null || { echo "the override anchor $o is not in this clone: refusing" >&2; return 1; }
+              GIT_NO_REPLACE_OBJECTS=1 git merge-base --is-ancestor "$o" "$AFTER" || { echo "the override anchor is not an ancestor of AFTER: refusing" >&2; return 1; }
+              echo "anchor set by PrompTugal__IaC: $o" >&2
+              echo "$o"
+              return 0
+            fi
             # The anchor (security@'s sixth ruling): the head_sha of the newest run of this workflow file, on dev, from a push,
             # that concluded success; only GitHub Actions creates runs. Every field is checked, not only the query.
             local api="https://api.github.com/repos/$GITHUB_REPOSITORY" json sha
